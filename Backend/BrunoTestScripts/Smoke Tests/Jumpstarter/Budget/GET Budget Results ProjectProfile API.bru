tests {
  test("GET Project Profile API should return 200", () => {
    expect(res.getStatus()).to.equal(200);
  });
  
  // Root-level fields
  test("Project ID should be present", () => {
    expect(res.body.id).to.not.be.empty;
  });
  
  test("User ID should be present", () => {
    expect(res.body.userId).to.not.be.empty;
  });
  
  test("Profile content type should be application/json", () => {
    expect(res.body.profileContentType).to.equal("application/json");
  });
  
  test("Created timestamp should be present", () => {
    expect(res.body.created).to.not.be.empty;
  });
  
  test("Last modified timestamp should be present", () => {
    expect(res.body.lastModified).to.not.be.empty;
  });
  
  // Interviews – Icebreaker
  test("Icebreaker interview should be completed", () => {
    expect(res.body.interviews.icebreaker.isCompleted).to.equal(true);
  });
  
  test("Icebreaker completedOn should be present", () => {
    expect(res.body.interviews.icebreaker.completedOn).to.not.be.null;
  });
  
  // Interviews – Style Personality
  test("Style Personality interview should be completed", () => {
    expect(res.body.interviews.stylePersonality.isCompleted).to.equal(true);
  });
  
  test("Style Personality completedOn should be present", () => {
    expect(res.body.interviews.stylePersonality.completedOn).to.not.be.null;
  });
  
  // Interviews – Style Finder
  test("Style Finder interview should not be completed", () => {
    expect(res.body.interviews.styleFinder.isCompleted).to.equal(false);
  });
  
  test("Style Finder completedOn should be null", () => {
    expect(res.body.interviews.styleFinder.completedOn).to.equal(null);
  });
  
  // Interviews – Style Image Analyzer
  test("Style Image Analyzer interview should not be completed", () => {
    expect(res.body.interviews.styleImageAnalyzer.isCompleted).to.equal(false);
  });
  
  test("Style Image Analyzer completedOn should be null", () => {
    expect(res.body.interviews.styleImageAnalyzer.completedOn).to.equal(null);
  });
  
  // Interviews – Style Tuner
  test("Style Tuner interview should be completed", () => {
    expect(res.body.interviews.styleTuner.isCompleted).to.equal(true);
  });
  
  test("Style Tuner completedOn should be present", () => {
    expect(res.body.interviews.styleTuner.completedOn).to.not.be.null;
  });
  
  // Interviews – Style Profile Favorites
  test("Style Profile Favorites interview should not be completed", () => {
    expect(res.body.interviews.styleProfileFavorites.isCompleted).to.equal(false);
  });
  
  test("Style Profile Favorites completedOn should be null", () => {
    expect(res.body.interviews.styleProfileFavorites.completedOn).to.equal(null);
  });
  
  // Interviews – Design Flow
  test("Design Intro interview should be completed", () => {
    expect(res.body.interviews.designIntro.isCompleted).to.equal(true);
  });
  
  test("Design Activities interview should be completed", () => {
    expect(res.body.interviews.designActivities.isCompleted).to.equal(true);
  });
  
  test("Storage Solution Favorites interview should be completed", () => {
    expect(res.body.interviews.storageSolutionFavorites.isCompleted).to.equal(true);
  });
  
  test("Design Cabinet Types interview should be completed", () => {
    expect(res.body.interviews.designCabinetTypes.isCompleted).to.equal(true);
  });
  
  // Interviews – Budget
  test("Budget interview should not be completed", () => {
    expect(res.body.interviews.budget.isCompleted).to.equal(false);
  });
  
  test("Budget completedOn should be null", () => {
    expect(res.body.interviews.budget.completedOn).to.equal(null);
  });
  
  // Interviews – Starting Budget
  test("Starting Budget interview should be completed", () => {
    expect(res.body.interviews.startingBudget.isCompleted).to.equal(true);
  });
  
  test("Starting Budget completedOn should be present", () => {
    expect(res.body.interviews.startingBudget.completedOn).to.not.be.null;
  });
  
  // Interviews – Itemized Budget
  test("Itemized Budget interview should be completed", () => {
    expect(res.body.interviews.itemizedBudget.isCompleted).to.equal(true);
  });
  
  test("Itemized Budget completedOn should be present", () => {
    expect(res.body.interviews.itemizedBudget.completedOn).to.not.be.null;
  });
  
  // Profile validations
  test("Remodel profile should not be completed", () => {
    expect(res.body.profile.remodelProfileCompleted).to.equal(false);
  });
  
  test("Last visited path should be /budget/start", () => {
    expect(res.body.profile.lastVisitedPath).to.equal("/budget/start");
  });
  
  test("Selected cabinets should be Semi-custom cabinets", () => {
    expect(res.body.profile.selectedCabinets).to.equal("Semi-custom cabinets");
  });
  
  // Feedback
  test("Feedback rating should be 0", () => {
    expect(res.body.feedback.rating).to.equal(0);
  });
  
  test("Feedback comment should be null", () => {
    expect(res.body.feedback.comment).to.equal(null);
  });
  
  // Dealer & Showroom
  test("Dealer shares should be an empty array", () => {
    expect(res.body.dealerShares).to.be.an("array").that.is.empty;
  });
  
  test("Showroom match type should be Unrestricted", () => {
    expect(res.body.showroomMatchType).to.equal("Unrestricted");
  });
  
  test("Showroom should not be assigned", () => {
    expect(res.body.showroomAssigned).to.equal(null);
  });
  
}
