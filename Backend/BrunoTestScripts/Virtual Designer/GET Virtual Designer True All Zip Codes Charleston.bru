meta {
  name: GET Virtual Designer True All Zip Codes Charleston
  type: http
  seq: 5
}

get {
  url: {{BaseURL}}/projectprofile/v1/data-science/postal-code/validate?postalCode={{ZIP_CODE_Charleston}}&projectId={{NEWPROJECTID}}
  body: none
  auth: inherit
}

params:query {
  postalCode: {{ZIP_CODE_Charleston}}
  projectId: {{NEWPROJECTID}}
}

script:pre-request {
  // Get ZIP codes from environment variable
  const zipCodesStr = bru.getEnvVar("zipCodes");
  
  // Fallback: if not in env, define inline
  const allZipCodes = zipCodesStr ? JSON.parse(zipCodesStr) : [
    
    // Charleston area ZIP codes
    "29405","29407","29409","29403","29425","29424","29401","29416","29402","29413",
    "29415","29417","29419","29422","29423","29404","29465","29464","29410","29406",
    "29418","29457","29414","29492","29412","29482","29455","29420","29466","29445",
    "29439","29451","29456","29485","29470","29487","29484","29429","29450","29449",
    "29483","29461","29486","29426","29434","29472","29438","29469","29435","29452",
    "29474","29437","29431","29453","29446","29458","29436","29479","29476","29448",
    "29468","29433","29447","29488","29048","29477","29564","29059","29920","29914",
    "29940","29945","29907","29471","29510","29904","29931","29901","29903","29163",
    "29475","29902","29590","29018","29440","29935","29481","29493","29941","29906",
    "29905","29056","29142","29442","29148","29432","29041","29102","29929","29916",
    "29912","29047","29580","29082","29944"
  ];
  
  
  
  // ── Random sample of 20 zip codes — generated ONCE per collection run ──────
  // Stored in a runtime var so every request in the run uses the SAME sample
  // set (otherwise each request would re-shuffle and get a different list).
  let sampledZips = bru.getVar("sampledZipCodes");
  
  if (!sampledZips) {
    // Fisher-Yates shuffle, then take first 20
    const pool = [...allZipCodes];
    for (let i = pool.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [pool[i], pool[j]] = [pool[j], pool[i]];
    }
    sampledZips = pool.slice(0, 20);
    bru.setVar("sampledZipCodes", JSON.stringify(sampledZips));
    console.log(`🎲 New random sample of 20 ZIP codes generated: ${sampledZips.join(", ")}`);
  } else {
    sampledZips = JSON.parse(sampledZips);
  }
  
  const currentRun = bru.getVar("runCount") || 0;
  
  if (currentRun < sampledZips.length) {
    bru.setVar("ZIP_CODE_Charleston", sampledZips[currentRun]);
    console.log(`✓ Using ZIP Code: ${sampledZips[currentRun]} (Run ${currentRun + 1}/${sampledZips.length})`);
  } else {
    console.log("✅ All 20 sampled ZIP codes completed!");
  }
}

script:post-response {
  // Get current run number
  const currentRun = bru.getVar("runCount") || 0;
  const nextRun = currentRun + 1;
  
  // Update run counter
  bru.setVar("runCount", nextRun);
  
  // Use the SAMPLED list length (20), not the full zipCodes list,
  // since pre-request only generates ZIP_CODE_Releigh for the sample.
  const sampledZipsStr = bru.getVar("sampledZipCodes");
  const totalIterations = sampledZipsStr ? JSON.parse(sampledZipsStr).length : 20;
  
  // Check if more iterations needed
  if (nextRun < totalIterations) {
      console.log(`→ Triggering iteration ${nextRun + 1}/${totalIterations}...`);
  
      // Trigger next request after a small delay
      setTimeout(() => {
          bru.runRequest("GET Virtual Designer True All Zip Codes Charleston");
      }, 2500);
  } else {
      console.log("🎉 All 20 sampled iterations completed!");
      bru.setVar("runCount", 0); // Reset counter
      bru.setVar("sampledZipCodes", null); // Clear sample so next run picks a fresh random 20
  }
}

tests {
  const requestedZip = bru.getVar("ZIP_CODE_Charleston");
  const currentRun = bru.getVar("runCount") || 0;
  
  console.log(`\n${"=".repeat(60)}`);
  console.log(`🧪 TESTING ZIP CODE: ${requestedZip} (Run ${currentRun + 1}/283)`);
  console.log(`${"=".repeat(60)}\n`);
  
  // Test 1: Status code is 200
  test("Status code is 200", () => {
      const statusCode = res.getStatus();
      console.log(`📋 Test 1: Status Code Validation`);
      console.log(`   ├─ Expected: 200`);
      console.log(`   ├─ Received: ${statusCode}`);
      console.log(`   └─ Result: ${statusCode === 200 ? '✅ PASS' : '❌ FAIL'}`);
      
      expect(statusCode).to.equal(200);
  });
  
  // Test 2: Response contains the ZIP code that was sent in the request
  test("Response contains the requested ZIP code", () => {
      console.log(`\n📋 Test 2: ZIP Code Validation`);
      
      const responseData = res.getBody();
      
      console.log(`   ├─ Requested ZIP: ${requestedZip}`);
      console.log(`   ├─ Response Type: ${Array.isArray(responseData) ? 'Array' : typeof responseData}`);
      console.log(`   ├─ Response Length: ${responseData.length}`);
      
      // Check if response is an array and has at least one item
      expect(responseData).to.be.an('array');
      expect(responseData.length).to.be.greaterThan(0);
      
      // Check if project_zipcode matches the requested ZIP
      const projectZip = responseData[0].project_zipcode;
      const dealerName = responseData[0].dealer_name || 'N/A';
      
      console.log(`   ├─ Response ZIP: ${projectZip}`);
      console.log(`   ├─ Dealer Name: ${dealerName}`);
      console.log(`   ├─ Match: ${projectZip === requestedZip ? 'Yes' : 'No'}`);
      console.log(`   └─ Result: ${projectZip === requestedZip ? '✅ PASS' : '❌ FAIL'}`);
      
      expect(projectZip).to.equal(bru.getVar("ZIP_CODE_Charleston"));
  });
  
  // Test 3: is_virtual_designer is true
  test("is_virtual_designer is true", () => {
      console.log(`\n📋 Test 3: Virtual Designer Flag Validation`);
      
      const responseData = res.getBody();
      const isVirtualDesigner = responseData[0].is_virtual_designer;
      
      console.log(`   ├─ Expected: true`);
      console.log(`   ├─ Received: ${isVirtualDesigner}`);
      console.log(`   ├─ Type: ${typeof isVirtualDesigner}`);
      console.log(`   └─ Result: ${isVirtualDesigner === true ? '✅ PASS' : '❌ FAIL'}`);
      
      expect(isVirtualDesigner).to.equal(true);
  });
  
  console.log(`\n${"=".repeat(60)}`);
  console.log(`✅ ALL TESTS PASSED FOR ZIP: ${requestedZip}`);
  console.log(`${"=".repeat(60)}\n`);
}
