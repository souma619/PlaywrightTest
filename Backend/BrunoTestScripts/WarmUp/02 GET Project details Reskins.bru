meta {
  name: 02 GET Project details Reskins
  type: http
  seq: 9
}

get {
  url: {{BaseURL}}/projectprofile/v1/projects/{{NEWPROJECTID}}/Reskins
  body: json
  auth: inherit
}

tests {
  var jsonData =res.getBody();
  bru.setEnvVar("RESKINID", jsonData[0].id);
  
  test("Status is 200", () => {
    expect(res.getStatus()).to.equal(200);
  });
}
