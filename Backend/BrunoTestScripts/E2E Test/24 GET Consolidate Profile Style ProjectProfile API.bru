meta {
  name: 24 GET Consolidate Profile Style ProjectProfile API
  type: http
  seq: 24
}

get {
  url: {{BaseURL}}/projectprofile/v1/projects/{{PROJECTID}}/profiles/style
  body: json
  auth: none
}

body:text {
  {"id":"2ef6204a-8e1d-48aa-b7fb-01416a57f276","questions":{"213db880-1284-46d7-999b-264822c31274":{"answers":{"7fabec79-730a-4f25-8588-12f6ec4d62b1":true,"6db65eed-4a67-4f55-b84d-394c007df27b":true,"d99544c0-c900-4a9d-a6e3-5ab24c1f64bb":false,"20f68a1f-ff0c-4ffb-8a3d-84bc3daa781c":false,"066353ac-cc66-43f5-bbb8-d3340267fc51":false,"8abc603a-2741-4dbd-893f-d5e7896c5505":true}},"f6a0916a-bbbe-4d8b-bb29-1a7c21f20c62":{"answers":{"1460a184-2c40-4de0-8615-287f046b0b32":false,"a3ac7b28-8afd-4a7a-806d-9e1853346ae4":true,"05285750-8971-4ab6-acdc-ddf7260da362":false}},"7b81d3ce-8ce5-4431-ac18-e57826496eec":{"answers":{"9129a787-65db-4e77-bbcf-0c401ee2da15":"","01951c59-5579-4a82-901a-34f100d58b1a":false,"afb0b04d-cfe7-47c0-b2e5-a3aa538fda8a":"30,000","2b04ca4c-a4b9-4f9e-b004-b4e2585291ee":"2,000"}}}}
}

tests {
  test("GET Consolidate Profile Style ProjectProfile API", () => {
      expect(res.getStatus()).to.equal(200);
  })
  // Basic fields
  test("Response contains essential profile fields", () => {
      const body = res.getBody();
      expect(body).to.have.property("id");
      expect(body).to.have.property("title");
      expect(body).to.have.property("subtitle");
      expect(body).to.have.property("displayName");
      expect(body).to.have.property("description");
  });
  
  // Introduction and designer quote
  test("Response contains introductionText and designerQuote", () => {
      const body = res.getBody();
      expect(body).to.have.property("intoductionText");
      expect(body).to.have.property("designerQuote");
  });
  
  // Keywords array
  test("Keywords array is present and not empty", () => {
      const body = res.getBody();
      expect(body.keywords).to.be.an("array");
      expect(body.keywords.length).to.be.greaterThan(0);
  });
  
  // Moodboard and corkboard images
  test("Moodboard and corkboard images have url and description", () => {
      const body = res.getBody();
      expect(body.moodboardImage).to.have.property("url");
      expect(body.moodboardImage).to.have.property("description");
      expect(body.corkboardImage).to.have.property("url");
      expect(body.corkboardImage).to.have.property("description");
  });
  
  // Images array
  test("Images array contains objects with url and description", () => {
      const body = res.getBody();
      expect(body.images).to.be.an("array");
      body.images.forEach(image => {
          expect(image).to.have.property("url");
          expect(image).to.have.property("description");
      });
  });
  
  // Favorites section
  test("Favorites section has heading, explanation and instructions", () => {
      const body = res.getBody();
      expect(body).to.have.property("favoritesHeading");
      expect(body).to.have.property("favoritesExplanation");
      expect(body).to.have.property("favoritesInstructions");
  });
  
  // Cabinet styles, wood species, paints, hardware, countertop
  const sections = ["cabinetDoorStyles", "cabinetWoodSpecies", "cabinetPaintsAndStains", "hardwareAndMetals", "countertopAndBacksplash"];
  
  sections.forEach(section => {
      test(`${section} contains answers with id, displayName, image and isFavorited`, () => {
          const body = res.getBody();
          expect(body[section]).to.have.property("answers");
          body[section].answers.forEach(answer => {
              expect(answer).to.have.property("id");
              expect(answer).to.have.property("displayName");
              expect(answer).to.have.property("image");
              expect(answer.image).to.have.property("url");
              expect(answer.image).to.have.property("description");
              expect(answer).to.have.property("isFavorited");
          });
      });
  });
}
