tests {
  test("GET Consolidate Profile Results ProjectProfile API", () => {
      expect(res.getStatus()).to.equal(200);
  })
  
  test("Response contains main identifiers", () => {
      expect(res.body).to.have.property("id");
      expect(res.body).to.have.property("userId");
      expect(res.body).to.have.property("profileContentType");
    });
  
    test("Profile section contains remodel completion and selections", () => {
      const profile = res.body.profile;
      expect(profile).to.have.property("remodelProfileCompleted", true);
      expect(profile).to.have.property("selectedStyle");
      expect(profile).to.have.property("selectedArchetype");
      expect(profile).to.have.property("selectedCabinets");
    });
  
    test("Interviews contain expected sections with completion status", () => {
      const interviews = res.body.interviews;
      expect(interviews).to.have.property("icebreaker");
      expect(interviews.icebreaker).to.have.property("isCompleted");
      expect(interviews).to.have.property("stylePersonality");
      expect(interviews.stylePersonality).to.have.property("isCompleted");
    });
  
    test("Feedback section exists and has default values", () => {
      const feedback = res.body.feedback;
      expect(feedback).to.have.property("id");
      expect(feedback).to.have.property("rating", 0);
      expect(feedback).to.have.property("comment", null);
    });
  
    test("Timestamps are present for profile completion and last modification", () => {
      expect(res.body).to.have.property("created");
      expect(res.body).to.have.property("lastModified");
      expect(res.body).to.have.property("profileCompletedOnUtc");
    });
  
    test("Dealer shares array exists", () => {
      expect(res.body).to.have.property("dealerShares");
      expect(res.body.dealerShares).to.be.an("array");
    });
  
  
}
