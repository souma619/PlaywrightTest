tests {
  test("GET Budget Breakdown API should return 200", () => {
    expect(res.getStatus()).to.equal(200);
  });
  
  // =======================
  // Top-level fields
  // =======================
  test("Skipped should be false", () => {
    expect(res.body.skipped).to.equal(false);
  });
  
