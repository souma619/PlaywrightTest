meta {
  name: 40 DELETE Reskin ID
  type: http
  seq: 40
}

delete {
  url: {{BaseURL}}/projectprofile/v1/projects/{{NEWPROJECTID}}/Reskins/{{RESKINID}}
  body: json
  auth: inherit
}

tests {
  const body = res.getBody();
  
  // ---------------- Status Code ----------------
  test("Status code is 200", () => {
      expect(res.getStatus()).to.equal(200);
  });
  
  // ---------------- Body contains message ----------------
  test("Response body contains max count message", () => {
      // Convert body to string in case it's not plain text
      const bodyText = typeof body === "string" ? body : JSON.stringify(body);
      expect(bodyText).to.contain("Delete operation successful.");
  });
  
}
