meta {
  name: 47 GET Designer With PDQ
  type: http
  seq: 46
}

get {
  url: {{BaseURL}}/projectprofile/v1/ChannelDiscovery?projectId={{NEWPROJECTID}}&postalCode={{ZIP_CODE}}
  body: json
  auth: inherit
}

params:query {
  projectId: {{NEWPROJECTID}}
  postalCode: {{ZIP_CODE}}
}

script:pre-request {
  // Get ZIP codes from environment variable
  const zipCodesStr = bru.getEnvVar("zipCodes");
  
  // Fallback: if not in env, define inline
  const zipCodes = zipCodesStr ? JSON.parse(zipCodesStr) : [
    // Original Map area ZIP codes
    "27607", "27608", "27609", "27615", "27616", "27617", "27612", "27704", "27707", "27712"]
  
  
  const currentRun = bru.getVar("runCountPdq") || 0;
  
  if (currentRun < zipCodes.length) {
      bru.setVar("ZIP_CODE", zipCodes[currentRun]);
      console.log(`✓ Using ZIP Code: ${zipCodes[currentRun]} (Run ${currentRun + 1}/${zipCodes.length})`);
  } else {
      console.log("✅ All ZIP codes completed!");
  }
}

script:post-response {
  // Array of ZIP codes (same as Pre-Request)
  const zipCodes = [
    // Original Map area ZIP codes
    "27607", "27608", "27609", "27615", "27616", "27617", "27612", "27704", "27707", "27712"];
  
  // Get current run number
  const currentRun = bru.getVar("runCountPdq") || 0;
  const nextRun = currentRun + 1;
  
  // Update run counter
  bru.setVar("runCountPdq", nextRun);
  
  // Check if more iterations needed
  if (nextRun < zipCodes.length) {
      console.log(`→ Triggering iteration ${nextRun + 1}/${zipCodes.length}...`);
      
      // Trigger next request after a small delay
      setTimeout(() => {
          bru.runRequest("47 GET Designer With PDQ");
      }, 2500);
  } else {
      console.log("🎉 All iterations completed!");
      bru.setVar("runCountPdq", 0); // Reset counter
  }
}

tests {
  const requestedZip = bru.getVar("ZIP_CODE");
  const currentRun = bru.getVar("runCountPdq") || 0;
  
  console.log(`\n${"=".repeat(60)}`);
  console.log(`🧪 TESTING ZIP CODE: ${requestedZip} (Run ${currentRun + 1}/283)`);
  console.log(`${"=".repeat(60)}\n`);
  
  const body = res.getBody();
  
  // Test 1: Status Code
  test("Status code is 200", () => {
      expect(res.getStatus()).to.equal(200);
  });
  
  // Test 2: Response is an array
  test("Response should be an array", () => {
      expect(body).to.be.an("array");
  });
  
  // Test 3: At least one dealer returned
  test("Response should contain at least one dealer", () => {
      expect(body.length).to.be.greaterThan(0);
  });
  
  // Map of "expected" logical field -> actual field name in the response
  const fieldMap = {
      dealer_name: "channelName",
      can_send_profile: "canSendProfile",
      dealer_id: "channelId",
      dealer_address_id: "addressId",
      distance_from_source: "distanceFromSource",
      dealer_address_1: "addressLine1",
      dealer_city: "city",
      dealer_state_code: "state",
      dealer_zipcode: "channelPostalCode",
      dealer_country_code: "country",
      dealer_phone: "phone",
      dealer_latitude: "latitude",
      dealer_longitude: "longitude",
      email: "email",
      url: "website",
      brands: "brands",
      project_city: "postalCity",
      project_state_code: "postalState",
      project_zipcode: "postalCode",
      project_country_code: "postalCountry",
      channel_type: "channelType",
      channel_product: "channelProduct"
  };
  
  // Test 4: Validate all nodes contain required fields
  test("All dealer nodes contain required fields", () => {
      body.forEach((dealer, index) => {
          console.log(`\n🔍 Validating Dealer ${index + 1}: ${dealer.channelName}`);
          Object.entries(fieldMap).forEach(([logicalName, actualField]) => {
              const exists = dealer[actualField] !== undefined;
              console.log(
                  `   ${exists ? "✅" : "❌"} ${logicalName} (${actualField}): ${
                      exists ? "Present" : "Missing"
                  }`
              );
              expect(
                  exists,
                  `Dealer ${index + 1} missing field: ${actualField} (expected as ${logicalName})`
              ).to.be.true;
          });
      });
  });
  
  // Test 5: Every dealer channel type must be Virtual Designer
  test('All dealers should have channelType = "Virtual Designer"', () => {
      body.forEach((dealer, index) => {
          console.log(
              `Dealer ${index + 1}: channelType = ${dealer.channelType}`
          );
          expect(
              dealer.channelType,
              `Dealer ${index + 1} has invalid channelType`
          ).to.equal("ONLINE_DEALER");
      });
  });
  
  // Test 6: Brands should contain at least one value
  test("All dealers should have at least one brand", () => {
      body.forEach((dealer, index) => {
          expect(
              dealer.brands,
              `Dealer ${index + 1} brands should be an array`
          ).to.be.an("array");
          expect(
              dealer.brands.length,
              `Dealer ${index + 1} should have at least one brand`
          ).to.be.greaterThan(0);
      });
  });
  
  // Test 7: Dealer Name must be "waite cabinet navigators"
  // NOTE: comparing case-insensitively since API returns lowercase, in case
  // that casing isn't guaranteed to stay consistent across environments.
  test('Dealer name must be "waite cabinet navigators"', () => {
      body.forEach((dealer, index) => {
          console.log(
              `Dealer ${index + 1}: channelName = ${dealer.channelName}`
          );
          expect(
              dealer.channelName?.toLowerCase(),
              `Dealer ${index + 1} has invalid channelName`
          ).to.equal("icabinetrydirect.com");
      });
  });
  
  // Test 8: canSendProfile should be true
  test("canSendProfile should be true", () => {
      body.forEach((dealer, index) => {
          console.log(
              `Dealer ${index + 1}: canSendProfile = ${dealer.canSendProfile}`
          );
          expect(
              dealer.canSendProfile,
              `Dealer ${index + 1} has invalid canSendProfile`
          ).to.equal(false);
      });
  });
  
  // Test 9: Requested ZIP should match response ZIP (postalCode field)
  test("Project zipcode should match requested zipcode", () => {
      // Read from the URL params instead of the potentially-overwritten variable
      const urlZip = req.getUrl().match(/postalCode=(\d+)/)?.[1];
      body.forEach((dealer, index) => {
          console.log(
              `Dealer ${index + 1}: Requested ZIP=${urlZip}, Response ZIP=${dealer.postalCode}`
          );
          expect(
              dealer.postalCode,
              `Dealer ${index + 1} returned incorrect project zipcode`
          ).to.equal(urlZip);
      });
  });
}
